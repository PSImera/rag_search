# Личные настройки пользователя. Скопируй в .env и правь под себя:
#   cp .env.example .env   (или copy .env.example .env в PowerShell)
# Файл .env в git не отслеживается. Значения отсюда подхватываются в src/config.py
# и НЕ перетирают уже заданные переменные окружения.

# Дефолтная коллекция
# Коллекция по умолчанию (когда --collection не указан явно и для warmup сервера).
RAG_DEFAULT_COLLECTION=default

# Локальная модель эмбеддингов кешируется в ~/.cache/huggingface
# Работает офлайн, токены платного API не тратятся.
# multilingual-e5-large — сильная многоязычная модель, отлично держит русский.
EMBEDDING_MODEL=intfloat/multilingual-e5-large